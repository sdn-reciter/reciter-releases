{
  "name": "Ночной янтарь",
  "author": "Reciter",
  "designSystem": "classic",
  "colors": { "background": "#1B1A17", "text": "#E8DCC8", "accent": "#D9A441" },
  "reader": { "background": "#211F1B", "text": "#E3D6BE", "accent": "#D9A441" },
  "shapes": { "extraSmall": 6, "small": 12, "medium": 18, "large": 24, "extraLarge": 30 },
  "typography": { "fontFamily": "serif", "scale": 1.05 },
  "layout": { "gridMinSize": 118, "gridSpacing": 12, "contentPadding": 14 },
  "controls": { "sliderThumb": "bar", "sliderTrackHeight": 4 },
  "bars": { "shape": "wavy", "curveHeight": 14, "opacity": 0.92, "inset": 12 },
  "topBar": { "shape": "rounded", "curveHeight": 14, "opacity": 1.0 },
  "gradients": { "accent": true, "accentTo": "#8A5E1F", "angle": 90, "bars": false },
  "surfaces": { "opacity": 0.9 },
  "notifications": { "opacity": 0.92, "inset": 16 },
  "visibility": {
    "showBookTitles": true,
    "showBookAuthors": true,
    "showProgressBadge": true,
    "showReaderProgress": true,
    "showAnnouncements": true
  },
  "elements": {
    "TOP_BAR": { "variant": "large" },
    "TABS": { "variant": "underline" }
  },
  "customElements": [
    { "id": "e1", "slot": "reader_top_bar", "function": "settings" }
  ],
  "background": {
    "type": "gradient",
    "colors": ["#1B1A17", "#3A2E1F"],
    "angle": 135,
    "imageAlpha": 0.25
  }
}
